 <class>MainMenu</class>
 <widget class="QMainWindow" name="MainMenu">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1480</width><height>900</height></rect></property>
  <property name="minimumSize"><size><width>1180</width><height>720</height></size></property>
  <property name="windowTitle"><string>JournalZaM</string></property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget { background:#F4F7F8; color:#25343A; font-family:"Segoe UI",Arial,sans-serif; }
QFrame#sidebar { background:#24343A; border:0; }
QLabel#lblBrand { color:white; font-size:28px; font-weight:900; }
QLabel#lblBrandSub { color:#AFC2C7; font-size:11px; font-weight:600; }
QLabel.sidebarSection { color:#7F989F; font-size:10px; font-weight:800; }
QPushButton[class="navButton"] { background:transparent; color:#CFDADD; border:0; border-radius:12px; text-align:left; padding:12px 16px; min-height:24px; font-size:13px; font-weight:650; }
QPushButton[class="navButton"]:hover { background:#30464D; color:white; }
QPushButton[class="navButton"][active="true"] { background:#DDEBE8; color:#204039; font-weight:850; }
QLabel#lblHeaderTitle { color:#23333A; font-size:27px; font-weight:850; }
QLabel#lblHeaderSubtitle, QLabel#lblToday { color:#667981; font-size:12px; }
QFrame[class="card"] { background:white; border:1px solid #D8E2E5; border-radius:16px; }
QLabel[class="sectionTitle"] { color:#2D4148; font-size:15px; font-weight:800; }
QLabel[class="hint"] { color:#7B8D94; font-size:10px; }
QLineEdit, QTextEdit, QComboBox, QDateEdit, QSpinBox, QFontComboBox {
 background:#FBFCFC; color:#263A42; border:1px solid #C9D7DB; border-radius:9px;
 min-height:34px; padding:0 9px; font-size:12px; selection-background-color:#CFE1DC;
}
QTextEdit { padding:8px; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QFontComboBox:focus { border:2px solid #6F9488; background:white; }
QPushButton[class="primary"] { background:#587F73; color:white; border:0; border-radius:10px; padding:9px 16px; font-weight:850; }
QPushButton[class="primary"]:hover { background:#4C7166; }
QPushButton[class="secondary"] { background:#EDF2F3; color:#40555D; border:1px solid #D1DDE0; border-radius:10px; padding:9px 14px; font-weight:750; }
QPushButton[class="danger"] { background:#FFF0F0; color:#A54F4F; border:1px solid #E8CACA; border-radius:10px; padding:9px 14px; font-weight:800; }
QPushButton[class="tool"] { background:#F7FAFA; color:#40555D; border:1px solid #D5E0E3; border-radius:7px; min-width:32px; min-height:30px; font-weight:750; }
QPushButton[class="tool"]:checked { background:#DDEBE8; color:#204039; border:1px solid #AFCBC4; }
QTableWidget, QListWidget { background:white; alternate-background-color:#F7F9FA; border:1px solid #D8E2E5; border-radius:12px; gridline-color:#E7ECEE; selection-background-color:#DDEBE8; selection-color:#23343A; }
QHeaderView::section { background:#E7EFED; color:#344950; border:0; border-right:1px solid #D6E1DF; padding:8px; font-weight:750; }
QCalendarWidget QWidget { alternate-background-color:#F5F8F8; }
QCalendarWidget QAbstractItemView:enabled { color:#31464D; selection-background-color:#6F9488; selection-color:white; }
QScrollArea { border:0; background:transparent; }
   </string>
