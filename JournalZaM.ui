         <!-- MEMORIES -->
         <widget class="QWidget" name="pageMemories">
          <layout class="QVBoxLayout">
           <item><layout class="QHBoxLayout"><item><widget class="QPushButton" name="btnRandomMemory"><property name="text"><string>✦ Take me somewhere</string></property></widget></item><item><spacer name="msp"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item></layout></item>
           <item><widget class="QFrame" name="memoryCard"><layout class="QVBoxLayout">
            <item><widget class="QLabel" name="lblMemoryHeading"><property name="text"><string>On this day</string></property><property name="styleSheet"><string>font-size:24px;font-weight:900;</string></property></widget></item>
            <item><widget class="QListWidget" name="listMemories"/></item>
            <item><widget class="QTextEdit" name="txtMemoryPreview"><property name="readOnly"><bool>true</bool></property></widget></item>
           </layout></widget></item>
          </layout>
         </widget>

         <!-- STATS -->
         <widget class="QWidget" name="pageStats">
          <layout class="QVBoxLayout">
           <item><layout class="QHBoxLayout">
            <item><widget class="QFrame" name="k1"><layout class="QVBoxLayout"><item><widget class="QLabel" name="lblStatEntries"><property name="text"><string>0</string></property><property name="styleSheet"><string>font-size:30px;font-weight:900;color:#587F73;</string></property></widget></item><item><widget class="QLabel" name="sl1"><property name="text"><string>Total entries</string></property></widget></item></layout></widget></item>
            <item><widget class="QFrame" name="k2"><layout class="QVBoxLayout"><item><widget class="QLabel" name="lblStatWords"><property name="text"><string>0</string></property><property name="styleSheet"><string>font-size:30px;font-weight:900;color:#6E86B7;</string></property></widget></item><item><widget class="QLabel" name="sl2"><property name="text"><string>Words written</string></property></widget></item></layout></widget></item>
            <item><widget class="QFrame" name="k3"><layout class="QVBoxLayout"><item><widget class="QLabel" name="lblStatStreak"><property name="text"><string>0</string></property><property name="styleSheet"><string>font-size:30px;font-weight:900;color:#B68B55;</string></property></widget></item><item><widget class="QLabel" name="sl3"><property name="text"><string>Current streak</string></property></widget></item></layout></widget></item>
            <item><widget class="QFrame" name="k4"><layout class="QVBoxLayout"><item><widget class="QLabel" name="lblStatRating"><property name="text"><string>—</string></property><property name="styleSheet"><string>font-size:30px;font-weight:900;color:#B97878;</string></property></widget></item><item><widget class="QLabel" name="sl4"><property name="text"><string>Average rating</string></property></widget></item></layout></widget></item>
            <item><widget class="QFrame" name="k5"><layout class="QVBoxLayout"><item><widget class="QLabel" name="lblStatPhotos"><property name="text"><string>0</string></property><property name="styleSheet"><string>font-size:30px;font-weight:900;color:#9B7AB8;</string></property></widget></item><item><widget class="QLabel" name="sl5"><property name="text"><string>Photos</string></property></widget></item></layout></widget></item>
           </layout></item>
           <item><layout class="QHBoxLayout">
            <item><widget class="QTableWidget" name="tableMonthlyStats"/></item>
            <item><widget class="QTableWidget" name="tableMoodStats"/></item>
           </layout></item>
          </layout>
         </widget>

         <!-- SETTINGS -->
         <widget class="QWidget" name="pageSettings">
          <layout class="QVBoxLayout">
           <item><widget class="QFrame" name="settingsCard"><layout class="QVBoxLayout">
            <item><widget class="QLabel" name="lblSettingsTitle"><property name="text"><string>Settings &amp; data</string></property><property name="styleSheet"><string>font-size:23px;font-weight:850;</string></property></widget></item>
            <item><widget class="QLabel" name="lblDatabasePath"><property name="text"><string>Database: —</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
            <item><widget class="QLabel" name="lblPrivacy"><property name="text"><string>Your journal stays local. Rich text and image bytes are stored in SQLite.</string></property></widget></item>
            <item>
             <layout class="QHBoxLayout" name="birthYearLayout">
              <item><widget class="QLabel" name="lblBirthYear"><property name="text"><string>Birth year (used only to place age-range memories approximately on the timeline)</string></property></widget></item>
              <item><widget class="QSpinBox" name="spinBirthYear"><property name="minimum"><number>1800</number></property><property name="maximum"><number>2200</number></property><property name="specialValueText"><string>Not set</string></property><property name="value"><number>1800</number></property></widget></item>
              <item><widget class="QPushButton" name="btnSaveBirthYear"><property name="text"><string>Save birth year</string></property></widget></item>
             </layout>
            </item>
            <item><layout class="QHBoxLayout"><item><widget class="QPushButton" name="btnExportHtml"><property name="text"><string>Export selected entry as HTML</string></property></widget></item><item><widget class="QPushButton" name="btnBackupDb"><property name="text"><string>Backup database</string></property></widget></item><item><spacer name="ssp"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item></layout></item>
            <item><spacer name="settingsSpace"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
           </layout></widget></item>
          </layout>
         </widget>

        </widget>
       </item>
      </layout>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
